#!/bin/sh
set -e

case "$1" in
  configure)
    # Download English OCR model if missing
    python3 - <<'PY'
import sys
sys.path.insert(0, '/usr/lib/python3/dist-packages')
from live_text_ocr.core.ocr_engine import ensure_language_data
try:
    ensure_language_data('eng')
except Exception as e:
    print(f"Warning: could not download language data: {e}", file=sys.stderr)
PY

    # Register shortcuts and enable user service as the installing user.
    # gsettings / systemd need the user's D-Bus session bus.
    if [ -n "${SUDO_USER}" ]; then
      if [ -x /usr/share/live-text-ocr/postinst-user-setup.sh ]; then
        su - "${SUDO_USER}" -c 'export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id - u)/bus"; /usr/share/live-text-ocr/postinst-user-setup.sh' || true
      fi
    fi
    ;;
esac

#DEBHELPER#

exit 0
